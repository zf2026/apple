name: |-
  AppRaven
desc: |-
  AppRaven
icon: |-
https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Want_Want_1.png
category: "去广告"

http:

  mitm:
    - "appraven.net"

  script:
    - match: https://appraven.net/appraven/graphql
      name: "AppRaven_2"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "AppRaven_2":
    url: https://raw.githubusercontent.com/Yu9191/Rewrite/main/AppRaven.js
    interval: 86400
