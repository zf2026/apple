name: |-
  壁纸
desc: |-
  壁纸
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1094.png

http:

  mitm:
    - "buy.itunes.apple.com"

  script:
    - match: ^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt
      name: "bizhi_2"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "bizhi_2":
    url: https://raw.githubusercontent.com/Yu9191/Rewrite/main/itunes/bizhi.js
    interval: 86400
