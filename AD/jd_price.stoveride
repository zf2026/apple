name: |-
  jd_price
desc: |-
  jd_price
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1079.png

http:

  mitm:
    - "in.m.jd.com"
    - "apapia-sqk-weblogic.manmanbuy.com"

  script:
    - match: ^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html
      name: "jd_price_28"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

    - match: ^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$
      name: "jd_price_28"
      type: request
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "jd_price_28":
    url: https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js
    interval: 86400
