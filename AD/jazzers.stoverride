name: |-
  jzzwds
desc: |-
  jzzwds
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1078.png

http:

  mitm:
    - "zwpp.wzbz123.com"

  script:
    - match: ^https?:\/\/zwpp\.wzbz123\.com\/api\/.+\/user\/getzwvipinfo
      name: "jzzwds_9"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "jzzwds_9":
    url: https://raw.githubusercontent.com/chxm1023/Rewrite/main/jzzwds.js
    interval: 86400
