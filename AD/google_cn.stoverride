name: |-
  Google搜索重定向
desc: |-
  将Google搜索重定向至.com域名，如遇频繁跳转请禁用本插件。
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Google.png
category: "去广告"

http:

  mitm:
    - "www.google.cn"

  url-rewrite:
    - >-
      ^https?:\/\/(www.)?(g|google)\.cn https://www.google.com 307
    - >-
      ^https?:\/\/(ditu|maps).google\.cn https://maps.google.com 307
