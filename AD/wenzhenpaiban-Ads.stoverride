name: |-
  问真八字排盘
desc: |-
  问真八字排盘
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1053.png
category: "去广告"
http:
  mitm:
    - "bzpp3.iwzbz.com"
  script:
    - match: ^https?:\/\/bzpp3\.iwzbz\.com\/api\/.+\/user\/getvipinfo
      name: "wenzhenbazi_10"
